# Required.
OPENAI_API_KEY=

# Embedding model. Default native dim is 1536 (matches schema).
# To switch to text-embedding-3-large, set vector(3072) in migrations/001_init.sql.
EMBEDDING_MODEL=text-embedding-3-small

# Used only by the manual Alice/Bob chat UI at http://localhost:8080/.
OPENAI_CHAT_MODEL=gpt-4o-mini

# Database (matches docker-compose; override only for local dev)
POSTGRES_USER=rag
POSTGRES_PASSWORD=rag
POSTGRES_DB=rag
POSTGRES_HOST=db
POSTGRES_PORT=5432

# Service
LOG_LEVEL=INFO
